<mxfile><diagram id="Architecture" name="Architecture"><mxGraphModel grid="0" page="0" pageWidth="1460" pageHeight="1000" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="art98 architecture, after the MVP (2026-11-10)" style="text;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;align=left;spacing=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="v2" value="Python on the host drives a real Windows 98 desktop in QEMU. Windows draws every pixel; the host says what should happen and captures the screen." style="text;strokeColor=none;fillColor=none;fontSize=13;align=left;spacing=0;fontColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="22" as="geometry"/></mxCell><mxCell id="v3" value="Host: Python, core/art98 and setup/art98_setup" style="rounded=0;fillColor=none;strokeColor=#CBD5E1;dashed=1;dashPattern=4 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="940" height="900" as="geometry"/></mxCell><mxCell id="v4" value="Guest: Windows 98 SE in QEMU" style="rounded=0;fillColor=none;strokeColor=#CBD5E1;dashed=1;dashPattern=4 4;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="440" height="900" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;scene .py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;examples/mvp/mvp.py&lt;/span&gt;" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="200" height="56" as="geometry"/></mxCell><mxCell id="v6" value="&lt;b&gt;state .json + BMPs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;examples/mvp/states, assets&lt;/span&gt;" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="130" width="210" height="56" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;cli.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;art98 doctor · setup (prep) · ping · render&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="250" height="56" as="geometry"/></mxCell><mxCell id="v8" value="&lt;b&gt;Scene  (anim/scene.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;construct · play · pause / wait / live · add / remove&lt;br&gt;set_state · prop&lt;br&gt;frame loop: apply, sync, capture&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="230" width="400" height="96" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;render  (anim/renderer.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;private copy → boot → record → scene.run → MP4, or lossless then GIF&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="250" height="96" as="geometry"/></mxCell><mxCell id="v10" value="&lt;b&gt;Animations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;animation.py: Animation, Animate (.animate), Wait, Instant, AnimationGroup, Succession, LaggedStart, MoveAlongPath&lt;br&gt;pointer.py: Glide, Click, Drag, Stroke, Menu&lt;br&gt;keys.py: Keys, Type…&lt;br&gt;window.py: Minimize, Close, Teleport&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="370" width="190" height="185" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;Props&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;props.py: Box, Spot, Prop, Win&lt;br&gt;pointer.py: Pointer&lt;br&gt;picture.py: Picture&lt;br&gt;rate_functions.py, vectors.py&lt;br&gt;&lt;i&gt;driven by animations; States open Pictures&lt;/i&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="370" width="190" height="150" as="geometry"/></mxCell><mxCell id="v12" value="&lt;b&gt;States&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;state.py: load and validate a JSON state, every problem at once (StateError)&lt;br&gt;setstate.py: apply back to front, repaint, place the pointer, then check (StateMismatch)&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="370" width="210" height="150" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;Session  (session.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;boot from the ready snapshot&lt;br&gt;revert: loadvm ready&lt;br&gt;FrameRecorder: frame() = SYNC + screendump → ffmpeg; live() follows the host clock&lt;br&gt;private_stage: copy in work/runs&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="700" y="370" width="250" height="150" as="geometry"/></mxCell><mxCell id="v14" value="&lt;b&gt;Parked&lt;/b&gt; in anim/apps.py, working but not exported: Notepad, Paint, Minesweeper, Screensaver, Dialog. Each returns as its own action class." style="rounded=1;arcSize=8;dashed=1;dashPattern=6 3;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;align=left;spacingLeft=8;fontColor=#64748B;whiteSpace=wrap;html=1;fontFamily=Helvetica;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="575" width="190" height="110" as="geometry"/></mxCell><mxCell id="v15" value="&lt;b&gt;ffmpeg&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;PPM frames → MP4 / FFV1&lt;/span&gt;" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=left;spacingLeft=14;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="540" width="210" height="56" as="geometry"/></mxCell><mxCell id="v16" value="&lt;b&gt;video&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;out.mp4 / .gif&lt;/span&gt;" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="612" width="210" height="50" as="geometry"/></mxCell><mxCell id="v17" value="&lt;b&gt;VM  (qemu.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;QMP, send_keys, load_snapshot&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="560" width="170" height="70" as="geometry"/></mxCell><mxCell id="v18" value="&lt;b&gt;guestfiles.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;copy a file once, to C:\ART98\F&amp;lt;hash&amp;gt;\&lt;br&gt;check a BMP on the host&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="700" width="190" height="100" as="geometry"/></mxCell><mxCell id="v19" value="&lt;b&gt;Bridge  (bridge.py, protocol.py)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;framed request / reply over COM1&lt;br&gt;CALL · ACALL + ! DONE · WINDOWS · PROCS · SPAWN · SYNC · PUT / GET&lt;br&gt;abandon() fails open calls on a revert&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="700" width="430" height="100" as="geometry"/></mxCell><mxCell id="v20" value="&lt;b&gt;setup/art98_setup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;once: vm → setup → init_api → ready&lt;br&gt;disc → installed Windows → ready snapshot&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="860" width="260" height="70" as="geometry"/></mxCell><mxCell id="v21" value="&lt;b&gt;work/golden.qcow2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ready snapshot, holds the product key&lt;br&gt;copied per run by private_stage&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;align=center;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340" y="850" width="220" height="90" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;QEMU (qemu-system-i386)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;COM1 serial · QMP socket · screendump · loadvm&lt;/span&gt;" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;align=left;spacingLeft=14;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="130" width="400" height="70" as="geometry"/></mxCell><mxCell id="v23" value="&lt;b&gt;Windows 98 SE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;user32, gdi32, kernel32 · Explorer desktop and taskbar · 800×600×16&lt;/span&gt;" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="260" width="400" height="80" as="geometry"/></mxCell><mxCell id="v24" value="&lt;b&gt;VIEW.EXE  (guest/picture_viewer/view.c)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;Art98View window: one BMP at 1:1 on grey, 4 KB&lt;/span&gt;" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="v25" value="&lt;b&gt;C:\ART98\&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;F&amp;lt;hash&amp;gt;\ files, gone after a revert&lt;/span&gt;" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="130" height="80" as="geometry"/></mxCell><mxCell id="v26" value="&lt;b&gt;AGENT.EXE  (guest/call_proxy/agent.c)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#334155&quot;&gt;Win32 call proxy on COM1, started at login: runs calls, spawns programs, lists windows, writes files&lt;/span&gt;" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;fontSize=13;align=left;spacingLeft=8;spacingRight=8;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontColor=#0F172A;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="700" width="400" height="100" as="geometry"/></mxCell><mxCell id="e27" value="subclasses" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;strokeColor=#475569;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.37;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="render" style="html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;edgeStyle=orthogonalEdgeStyle;rounded=1;lab