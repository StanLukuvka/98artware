<mxfile><diagram id="prep-pipeline" name="prep-pipeline"><mxGraphModel dx="1000" dy="1010" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="1010" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Prep pipeline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="952" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value='&lt;font face="Courier New"&gt;art98 prep&lt;/font&gt; runs five stages. Each one is recorded in &lt;font face="Courier New"&gt;work/state.json&lt;/font&gt;; &lt;font face="Courier New"&gt;--from STAGE&lt;/font&gt; repeats it and all that follow.' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="952" height="24" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Needs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="72" width="270" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Stage&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="72" width="280" height="22" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Leaves in work/&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="646" y="72" width="330" height="22" as="geometry"/></mxCell><mxCell id="n_media" value='&lt;font face="Courier New"&gt;win98se.iso&lt;/font&gt;&lt;br&gt;product key (checked, used in disk)&lt;br&gt;&lt;font face="Courier New"&gt;windows_handlers/build/agent.exe&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="106" width="270" height="120" as="geometry"/></mxCell><mxCell id="s_media" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="98" width="280" height="136" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:16px"&gt;&lt;font face="Courier New"&gt;media&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Checks the agent loads on 98,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;unpacks &lt;font face="Courier New"&gt;WIN98&lt;/font&gt;, pulls the boot floppy,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;deletes &lt;font face="Courier New"&gt;JO.SYS&lt;/font&gt;, writes the startup files&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_media"><mxGeometry x="12" y="6" width="256" height="92" as="geometry"/></mxCell><mxCell id="t_media" value="7z, mtools" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_media"><mxGeometry x="70" y="102" width="140" height="26" as="geometry"/></mxCell><mxCell id="o_media" value='&lt;font face="Courier New"&gt;media/win98/&lt;/font&gt; setup files&lt;br&gt;&lt;font face="Courier New"&gt;boot.img&lt;/font&gt; patched floppy&lt;br&gt;&lt;font face="Courier New"&gt;AUTOEXEC.BAT&lt;/font&gt;, &lt;font face="Courier New"&gt;CONFIG.SYS&lt;/font&gt;&lt;br&gt;(copies of what went on the floppy)' style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="106" width="330" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_media" target="s_media"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_media" target="o_media"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_disk" value='&lt;font face="Courier New"&gt;media/win98/&lt;/font&gt;&lt;br&gt;product key&lt;br&gt;&lt;font face="Courier New"&gt;windows_handlers/build/mbr.bin&lt;/font&gt;, &lt;font face="Courier New"&gt;agent.exe&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="270" width="270" height="120" as="geometry"/></mxCell><mxCell id="s_disk" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="262" width="280" height="136" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:16px"&gt;&lt;font face="Courier New"&gt;disk&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Makes the raw disk: boot record, FAT32.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Copies in setup files, &lt;font face="Courier New"&gt;MSBATCH.INF&lt;/font&gt;,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;AGENT.EXE&lt;/font&gt;&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_disk"><mxGeometry x="12" y="6" width="256" height="92" as="geometry"/></mxCell><mxCell id="t_disk" value="mtools" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_disk"><mxGeometry x="70" y="102" width="140" height="26" as="geometry"/></mxCell><mxCell id="o_disk" value='&lt;font face="Courier New"&gt;install.img&lt;/font&gt; raw, 2047 MB&lt;br&gt;&lt;font face="Courier New"&gt;C:\WIN98&lt;/font&gt;, &lt;font face="Courier New"&gt;C:\ART98\AGENT.EXE&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;MSBATCH.INF&lt;/font&gt; goes in the image.&lt;br&gt;It holds the key, so the work copy is deleted.' style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="270" width="330" height="120" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_disk" target="s_disk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_disk" target="o_disk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_media" target="s_disk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n_install" value='&lt;font face="Courier New"&gt;install.img&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;boot.img&lt;/font&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="434" width="270" height="120" as="geometry"/></mxCell><mxCell id="s_install" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="426" width="280" height="136" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b style="font-size:16px"&gt;&lt;font face="Courier New"&gt;install&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Runs Setup over several boots until the&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;agent says hello, answering prompts&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;(see install-boot-chain)&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_install"><mxGeometry x="12" y="6" width="256" height="92" as="geometry"/></mxCell><mxCell id="t_install" value="QEMU" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_install"><mxGeometry x="70" y="102" width="140" height="26" as="geometry"/></mxCell><mxCell id="o_install" value='&lt;font face="Courier New"&gt;install.img&lt;/font&gt; with Windows on it&lt;br&gt;&lt;font face="Courier New"&gt;shots/install&amp;lt;boot&amp;gt;-&amp;lt;n&amp;gt;.png&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;shots/probe.ppm&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New"&gt;qemu.log&lt;/font&gt;' style=