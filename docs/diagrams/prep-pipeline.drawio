<mxfile><diagram id="prep-pipeline" name="prep-pipeline"><mxGraphModel dx="1000" dy="870" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="870" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Setup pipeline&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="952" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="&lt;font face=&quot;Courier New&quot;&gt;art98 setup&lt;/font&gt; runs four steps. Each one is recorded in &lt;font face=&quot;Courier New&quot;&gt;work/state.json&lt;/font&gt;; &lt;font face=&quot;Courier New&quot;&gt;--from STEP&lt;/font&gt; repeats it and all that follow." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="952" height="24" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;Needs&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="72" width="270" height="22" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="330" y="72" width="280" height="22" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Leaves in work/&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="646" y="72" width="330" height="22" as="geometry" /></mxCell><mxCell id="n_vm" value="&lt;font face=&quot;Courier New&quot;&gt;win98se.iso&lt;/font&gt;&lt;br&gt;product key (answer file)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;windows_handlers/build/&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;agent.exe&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;mbr.bin&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="106" width="270" height="120" as="geometry" /></mxCell><mxCell id="s_vm" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="98" width="280" height="136" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;vm&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Checks agent, unpacks &lt;font face=&quot;Courier New&quot;&gt;WIN98&lt;/font&gt;, patches&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;boot floppy, makes the raw disk, adds&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Setup files, &lt;font face=&quot;Courier New&quot;&gt;MSBATCH.INF&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;AGENT.EXE&lt;/font&gt;&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_vm"><mxGeometry x="12" y="6" width="256" height="92" as="geometry" /></mxCell><mxCell id="t_vm" value="7z, mtools" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_vm"><mxGeometry x="70" y="102" width="140" height="26" as="geometry" /></mxCell><mxCell id="o_vm" value="&lt;font face=&quot;Courier New&quot;&gt;media/win98/&lt;/font&gt; setup files, &lt;font face=&quot;Courier New&quot;&gt;boot.img&lt;/font&gt; floppy&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt; raw, 2047 MB&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;C:\WIN98&lt;/font&gt;, &lt;font face=&quot;Courier New&quot;&gt;C:\ART98\AGENT.EXE&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;MSBATCH.INF&lt;/font&gt; goes in the image.&lt;br&gt;It holds the key, so the work copy is deleted." style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="106" width="330" height="120" as="geometry" /></mxCell><mxCell id="c6" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_vm" target="s_vm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c7" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_vm" target="o_vm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_setup" value="&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;boot.img&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="270" width="270" height="120" as="geometry" /></mxCell><mxCell id="s_setup" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="262" width="280" height="136" as="geometry" /></mxCell><mxCell id="c12" value="&lt;b style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;setup&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Runs Setup over several boots until the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;agent says hello, answering prompts&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;(see install-boot-chain)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_setup"><mxGeometry x="12" y="6" width="256" height="92" as="geometry" /></mxCell><mxCell id="t_setup" value="QEMU" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_setup"><mxGeometry x="70" y="102" width="140" height="26" as="geometry" /></mxCell><mxCell id="o_setup" value="&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt; with Windows on it&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;shots/install&amp;lt;boot&amp;gt;-&amp;lt;n&amp;gt;.png&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;shots/probe.ppm&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;qemu.log&lt;/font&gt;" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="270" width="330" height="120" as="geometry" /></mxCell><mxCell id="c13" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_setup" target="s_setup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c14" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_setup" target="o_setup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c15" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_vm" target="s_setup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_init_api" value="&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt;" style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="434" width="270" height="120" as="geometry" /></mxCell><mxCell id="s_init_api" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="426" width="280" height="136" as="geometry" /></mxCell><mxCell id="c16" value="&lt;b style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;init_api&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Edits &lt;font face=&quot;Courier New&quot;&gt;MSDOS.SYS&lt;/font&gt; offline, converts to&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;qcow2, boots once, agent says hello&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;and answers PING, then shuts down&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_init_api"><mxGeometry x="12" y="6" width="256" height="92" as="geometry" /></mxCell><mxCell id="t_init_api" value="mtools, qemu-img, QEMU" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_init_api"><mxGeometry x="55" y="102" width="170" height="26" as="geometry" /></mxCell><mxCell id="o_init_api" value="&lt;font face=&quot;Courier New&quot;&gt;golden.qcow2&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt; stays until ready ends" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="434" width="330" height="120" as="geometry" /></mxCell><mxCell id="c17" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_init_api" target="s_init_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c18" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_init_api" target="o_init_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c19" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_setup" target="s_init_api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n_ready" value="&lt;font face=&quot;Courier New&quot;&gt;golden.qcow2&lt;/font&gt;&lt;br&gt;the agent, over Bridge" style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="598" width="270" height="120" as="geometry" /></mxCell><mxCell id="s_ready" value="" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#DBEAFE;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="590" width="280" height="136" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:16px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ready&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Registry settings, cleans the Run keys,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;800x600x16, reboot, quiet screen,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;checks the desktop, saves the snapshot&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="s_ready"><mxGeometry x="12" y="6" width="256" height="92" as="geometry" /></mxCell><mxCell id="t_ready" value="QEMU" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="s_ready"><mxGeometry x="70" y="102" width="140" height="26" as="geometry" /></mxCell><mxCell id="o_ready" value="&lt;font face=&quot;Courier New&quot;&gt;golden.qcow2&lt;/font&gt; + snapshot &lt;font face=&quot;Courier New&quot;&gt;ready&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;image.json&lt;/font&gt; the VM config&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;shots/ready.png&lt;/font&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;install.img&lt;/font&gt; deleted" style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="646" y="598" width="330" height="120" as="geometry" /></mxCell><mxCell id="c21" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_ready" target="s_ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c22" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_ready" target="o_ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c23" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_init_api" target="s_ready"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="gold" value="&lt;b style=&quot;font-size:14px&quot;&gt;golden.qcow2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;snapshot &lt;f