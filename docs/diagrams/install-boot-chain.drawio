<mxfile><diagram id="install-boot-chain" name="install-boot-chain"><mxGraphModel dx="1000" dy="1120" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="1120" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Install boot chain&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="952" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value='Each guest reboot ends QEMU, so &lt;font face="Courier New"&gt;install&lt;/font&gt; is a chain of new VMs on one disk. Three boots, as on the measured run.' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="952" height="24" as="geometry"/></mxCell><mxCell id="L_g" value="Guest" style="fillColor=#ECFDF5;strokeColor=#6EE7B7;fontColor=#047857;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="400" height="936" as="geometry"/></mxCell><mxCell id="L_q" value="QEMU" style="fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#92400E;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="436" y="76" width="150" height="936" as="geometry"/></mxCell><mxCell id="L_h" value='Host: &lt;font face="Courier New"&gt;install()&lt;/font&gt; in setup.py' style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="602" y="76" width="378" height="936" as="geometry"/></mxCell><mxCell id="r_106" value="&lt;b&gt;Boot 1, from the floppy&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="L_g"><mxGeometry x="16" y="30" width="300" height="22" as="geometry"/></mxCell><mxCell id="h1" value='&lt;b style="font-size:14px"&gt;Start VM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;boot.img&lt;/font&gt; in drive A, &lt;font face="Courier New"&gt;boot once=a&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="56" width="346" height="48" as="geometry"/></mxCell><mxCell id="q1" value='&lt;b style="font-size:14px"&gt;New process&lt;/b&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="56" width="122" height="48" as="geometry"/></mxCell><mxCell id="g1" value="&lt;b style=&quot;font-size:14px&quot;&gt;Floppy boots&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;JO.SYS&lt;/font&gt; menu deleted, so it can't fall back to C:&lt;/span&gt;" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="56" width="368" height="48" as="geometry"/></mxCell><mxCell id="g2" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;AUTOEXEC.BAT&lt;/font&gt; runs Setup&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;SETUP.EXE C:\WIN98\MSBATCH.INF&lt;/font&gt;&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="124" width="368" height="48" as="geometry"/></mxCell><mxCell id="g3" value='&lt;b style="font-size:14px"&gt;Setup copies the Windows files, then reboots&lt;/b&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="192" width="368" height="48" as="geometry"/></mxCell><mxCell id="q3" value='&lt;b style="font-size:14px"&gt;Exits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;-no-reboot&lt;/font&gt;&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="192" width="122" height="48" as="geometry"/></mxCell><mxCell id="h3" value='&lt;b style="font-size:14px"&gt;Link closes, QEMU has exited&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Drop the floppy, next boot&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="192" width="346" height="48" as="geometry"/></mxCell><mxCell id="r_338" value="&lt;b&gt;Boot 2, from the disk&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="L_g"><mxGeometry x="16" y="262" width="300" height="22" as="geometry"/></mxCell><mxCell id="h4" value='&lt;b style="font-size:14px"&gt;Start VM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;disk only&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="288" width="346" height="48" as="geometry"/></mxCell><mxCell id="q4" value='&lt;b style="font-size:14px"&gt;New process&lt;/b&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="288" width="122" height="48" as="geometry"/></mxCell><mxCell id="g4" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;mbr.bin&lt;/font&gt; chains to the boot sector&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Setup carries on&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="288" width="368" height="48" as="geometry"/></mxCell><mxCell id="g5" value='&lt;b style="font-size:14px"&gt;First-boot wizard&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;640x480, four pages. Name and key are already filled in from the answer file&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="356" width="368" height="66" as="geometry"/></mxCell><mxCell id="h5" value="&lt;b style=&quot;font-size:14px&quot;&gt;Screen matches the wizard's pixels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Presses through it, &lt;font face=&quot;Courier New&quot;&gt;alt+a&lt;/font&gt; accepts the licence&lt;/span&gt;" style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="356" width="346" height="66" as="geometry"/></mxCell><mxCell id="g6" value='&lt;b style="font-size:14px"&gt;Setup sets up hardware, then reboots&lt;/b&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="442" width="368" height="48" as="geometry"/></mxCell><mxCell id="q6" value='&lt;b style="font-size:14px"&gt;Exits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;-no-reboot&lt;/font&gt;&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="442" width="122" height="48" as="geometry"/></mxCell><mxCell id="h6" value='&lt;b style="font-size:14px"&gt;Link closes, QEMU has exited&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Next boot&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="442" width="346" height="48" as="geometry"/></mxCell><mxCell id="r_588" value="&lt;b&gt;Boot 3, first real desktop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="L_g"><mxGeometry x="16" y="512" width="300" height="22" as="geometry"/></mxCell><mxCell id="h7" value='&lt;b style="font-size:14px"&gt;Start VM&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;disk only&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="538" width="346" height="48" as="geometry"/></mxCell><mxCell id="q7" value='&lt;b style="font-size:14px"&gt;New process&lt;/b&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="538" width="122" height="48" as="geometry"/></mxCell><mxCell id="g7a" value='&lt;b style="font-size:14px"&gt;Windows boots from the disk&lt;/b&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="538" width="368" height="48" as="geometry"/></mxCell><mxCell id="g7" value='&lt;b style="font-size:14px"&gt;Logon prompt&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;appears once&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="606" width="368" height="48" as="geometry"/></mxCell><mxCell id="h7b" value="&lt;b style=&quot;font-size:14px&quot;&gt;Screen matches the logon prompt's pixels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;&lt;font face=&quot;Courier New&quot;&gt;ret&lt;/font&gt;: a blank password, so it never returns&lt;/span&gt;" style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="606" width="346" height="48" as="geometry"/></mxCell><mxCell id="g8" value='&lt;b style="font-size:14px"&gt;Desktop. Run key starts &lt;font face="Courier New"&gt;AGENT.EXE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;the answer file set the key&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="674" width="368" height="48" as="geometry"/></mxCell><mxCell id="g9" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;! HELLO 1 &amp;lt;tick&amp;gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;sent at start, then every 3 s until a request&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="742" width="368" height="48" as="geometry"/></mxCell><mxCell id="h9" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;wait_event("HELLO")&lt;/font&gt; returns&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;wait_ready()&lt;/font&gt; checks with &lt;font face="Courier New"&gt;PING&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="742" width="346" height="48" as="geometry"/></mxCell><mxCell id="h10" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;acall ExitWindowsEx&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;reboot, forced&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometry x="16" y="810" width="346" height="48" as="geometry"/></mxCell><mxCell id="g10" value='&lt;b style="font-size:14px"&gt;Windows goes down&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;the reboot ends QEMU, as every reboot here does&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_g"><mxGeometry x="16" y="810" width="368" height="116" as="geometry"/></mxCell><mxCell id="q10" value='&lt;b style="font-size:14px"&gt;Exits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;-no-reboot&lt;/font&gt;&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_q"><mxGeometry x="14" y="878" width="122" height="48" as="geometry"/></mxCell><mxCell id="h11" value='&lt;b style="font-size:14px"&gt;Step &lt;font face="Courier New"&gt;setup&lt;/font&gt; done&lt;/b&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="L_h"><mxGeometr