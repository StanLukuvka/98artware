<mxfile><diagram id="action-stack" name="action-stack"><mxGraphModel dx="1000" dy="950" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="950" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Action stack&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="952" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One call down to Win32 and back. Example: &lt;font face=&quot;Courier New&quot;&gt;Win.refresh()&lt;/font&gt; reads a window's rectangle." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="952" height="24" as="geometry"/></mxCell><mxCell id="zh" value="Host" style="fillColor=#EFF6FF;strokeColor=#93C5FD;fontColor=#1E40AF;rounded=1;arcSize=2;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="76" width="960" height="262" as="geometry"/></mxCell><mxCell id="zq" value="Link" style="fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#92400E;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="346" width="960" height="92" as="geometry"/></mxCell><mxCell id="zg" value="Guest" style="fillColor=#ECFDF5;strokeColor=#6EE7B7;fontColor=#047857;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="446" width="960" height="420" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Scene&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zh"><mxGeometry x="12" y="24" width="112" height="60" as="geometry"/></mxCell><mxCell id="l1" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;Scene.play&lt;/font&gt; updates animations, props send changes&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;as &lt;font face="Courier New"&gt;Bridge&lt;/font&gt; calls. &lt;font face="Courier New"&gt;Keys&lt;/font&gt; use QMP &lt;font face="Courier New"&gt;send-key&lt;/font&gt; instead&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="130" y="24" width="390" height="60" as="geometry"/></mxCell><mxCell id="r1" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;CallResult&lt;/font&gt;: value, last error, buffers&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="570" y="24" width="374" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Bridge&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zh"><mxGeometry x="12" y="96" width="112" height="66" as="geometry"/></mxCell><mxCell id="l2" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;guest.user32.GetWindowRect(1234, Out(16))&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;request()&lt;/font&gt; takes an id, parks a &lt;font face="Courier New"&gt;_Pending&lt;/font&gt;, waits&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="130" y="96" width="390" height="66" as="geometry"/></mxCell><mxCell id="r2" value='&lt;span style="font-size:13px"&gt;Reader thread &lt;font face="Courier New"&gt;_read_loop&lt;/font&gt; fills the &lt;font face="Courier New"&gt;_Pending&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;and wakes the waiting caller&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="570" y="96" width="374" height="66" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Framing, CRC&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zh"><mxGeometry x="12" y="174" width="112" height="76" as="geometry"/></mxCell><mxCell id="l3" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;encode_request&lt;/font&gt; + &lt;font face="Courier New"&gt;frame&lt;/font&gt;, CRC-16:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;7 CALL "user32" "GetWindowRect"&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;1234 &amp;amp;16 *0812\n&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="130" y="174" width="390" height="76" as="geometry"/></mxCell><mxCell id="r3" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;unframe&lt;/font&gt; checks the CRC, a bad line is dropped:&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;7 OK 1 0 #0a0000001400... *bf8a\n&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zh"><mxGeometry x="570" y="174" width="374" height="76" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Serial&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zq"><mxGeometry x="12" y="24" width="112" height="58" as="geometry"/></mxCell><mxCell id="l4" value='&lt;span style="font-size:13px"&gt;unix socket, QEMU chardev, emulated COM1&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;115200 baud, not paced by QEMU&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zq"><mxGeometry x="130" y="24" width="390" height="58" as="geometry"/></mxCell><mxCell id="r4" value='&lt;span style="font-size:13px"&gt;COM1, QEMU chardev, unix socket&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zq"><mxGeometry x="570" y="24" width="374" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Reader thread&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zg"><mxGeometry x="12" y="24" width="112" height="76" as="geometry"/></mxCell><mxCell id="l5" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;reader_thread&lt;/font&gt; polls &lt;font face="Courier New"&gt;ReadFile&lt;/font&gt;, builds the line,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;checks the CRC (&lt;font face="Courier New"&gt;! BADFRAME&lt;/font&gt; if wrong),&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;PostMessage WM_REQUEST&lt;/font&gt;&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="130" y="24" width="390" height="76" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;UI thread&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zg"><mxGeometry x="12" y="112" width="112" height="76" as="geometry"/></mxCell><mxCell id="l6" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;request_proc&lt;/font&gt; takes the message: &lt;font face="Courier New"&gt;job_parse&lt;/font&gt;,&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;then verbs: &lt;font face="Courier New"&gt;CALL&lt;/font&gt; runs here, &lt;font face="Courier New"&gt;ACALL&lt;/font&gt; on a new thread&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="130" y="112" width="390" height="76" as="geometry"/></mxCell><mxCell id="r6" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;send_buf&lt;/font&gt; adds the CRC, &lt;font face="Courier New"&gt;tx_lock&lt;/font&gt;, &lt;font face="Courier New"&gt;com_write&lt;/font&gt;.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Replies skip the reader thread&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="570" y="112" width="374" height="76" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Resolve&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zg"><mxGeometry x="12" y="200" width="112" height="70" as="geometry"/></mxCell><mxCell id="l7" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;LoadLibraryA("user32")&lt;/font&gt;&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;GetProcAddress(..., "GetWindowRect")&lt;/font&gt;&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="130" y="200" width="390" height="70" as="geometry"/></mxCell><mxCell id="r7" value='&lt;span style="font-size:13px"&gt;result, &lt;font face="Courier New"&gt;GetLastError&lt;/font&gt;, out buffers as hex.&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;Failures reply &lt;font face="Courier New"&gt;ERR NODLL&lt;/font&gt; or &lt;font face="Courier New"&gt;ERR NOFUNC&lt;/font&gt;&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="570" y="200" width="374" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Invoke&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zg"><mxGeometry x="12" y="282" width="112" height="58" as="geometry"/></mxCell><mxCell id="l8" value='&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;invoke()&lt;/font&gt; pushes the arguments right to left, calls, restores ESP, so stdcall and cdecl both work&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="130" y="282" width="814" height="58" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Win32&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#334155;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="zg"><mxGeometry x="12" y="352" width="112" height="54" as="geometry"/></mxCell><mxCell id="l9" value="&lt;span style=&quot;font-size:13px&quot;&gt;The API call runs inside the agent's process: &lt;font face=&quot;Courier New&quot;&gt;user32!GetWindowRect&lt;/font&gt;&lt;/span&gt;" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="zg"><mxGeometry x="130" y="352" width="814" height="54" as="geometry"/></mxCell><mxCell id="c11" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zh" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="zh" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1E3A8A;strokeWidth=2.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1E3A8A;strokeWidth=2.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFil