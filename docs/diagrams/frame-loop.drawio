<mxfile><diagram id="frame-loop" name="frame-loop"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Frame loop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="952" height="30" as="geometry"/></mxCell><mxCell id="subtitle" value="One video frame. The script says when a frame exists, so a slow host makes the same video as a fast one." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="42" width="952" height="24" as="geometry"/></mxCell><mxCell id="gf" value='Apply state, then &lt;font face="Courier New"&gt;frame(hold)&lt;/font&gt;: the script sets the pace' style="fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="690" height="196" as="geometry"/></mxCell><mxCell id="a" value='&lt;b style="font-size:14px"&gt;Apply state&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;Scene.play&lt;/font&gt;: update animations, &lt;font face="Courier New"&gt;_apply()&lt;/font&gt; sends changes&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gf"><mxGeometry x="16" y="36" width="176" height="104" as="geometry"/></mxCell><mxCell id="b" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;video.frame()&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;first &lt;font face="Courier New"&gt;bridge.sync()&lt;/font&gt;: &lt;font face="Courier New"&gt;SYNC 0 500&lt;/font&gt;, waits for the reply&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gf"><mxGeometry x="228" y="36" width="176" height="104" as="geometry"/></mxCell><mxCell id="c" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;verb_sync&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;each visible window: &lt;font face="Courier New"&gt;RedrawWindow&lt;/font&gt;, &lt;font face="Courier New"&gt;WM_NULL&lt;/font&gt; round trip. Then &lt;font face="Courier New"&gt;GdiFlush&lt;/font&gt; and the tick count&lt;/span&gt;' style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gf"><mxGeometry x="442" y="26" width="232" height="124" as="geometry"/></mxCell><mxCell id="c2" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="gf" source="a" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c3" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1E3A8A;strokeWidth=2.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3742;entryDx=0;entryDy=0;" edge="1" parent="gf" source="b" target="c"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c4" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#1E3A8A;strokeWidth=2.5;dashed=1;dashPattern=6 3;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0;exitY=0.6258;exitDx=0;exitDy=0;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="gf" source="c" target="b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="When the reply comes the guest has painted, so the capture shows the state just applied." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="gf"><mxGeometry x="16" y="154" width="660" height="34" as="geometry"/></mxCell><mxCell id="gl" value='&lt;font face="Courier New"&gt;live(seconds)&lt;/font&gt;: the alternate path, follows the host clock' style="fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="296" width="690" height="196" as="geometry"/></mxCell><mxCell id="l1" value='&lt;b style="font-size:14px"&gt;Next index&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;ends early if &lt;font face="Courier New"&gt;stop_condition&lt;/font&gt; is true&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gl"><mxGeometry x="16" y="36" width="176" height="76" as="geometry"/></mxCell><mxCell id="l2" value='&lt;b style="font-size:14px"&gt;Sleep&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;until &lt;font face="Courier New"&gt;start + i / fps&lt;/font&gt;&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gl"><mxGeometry x="228" y="36" width="176" height="76" as="geometry"/></mxCell><mxCell id="l3" value='&lt;b style="font-size:14px"&gt;No &lt;font face="Courier New"&gt;SYNC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;the capture takes what is on screen&lt;/span&gt;' style="rounded=0;fillColor=#FFFFFF;strokeColor=#475569;dashed=1;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gl"><mxGeometry x="442" y="36" width="232" height="76" as="geometry"/></mxCell><mxCell id="c6" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="gl" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="gl" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value='For things that move by themselves, like a screensaver. &lt;font face="Courier New"&gt;Scene.wait&lt;/font&gt; and &lt;font face="Courier New"&gt;Scene.live&lt;/font&gt; land here. This stretch of video depends on host speed.' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="gl"><mxGeometry x="16" y="120" width="660" height="66" as="geometry"/></mxCell><mxCell id="cap" value='&lt;font face="Courier New"&gt;_capture(hold)&lt;/font&gt;' style="fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="250" height="556" as="geometry"/></mxCell><mxCell id="s1" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;vm.screenshot()&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;QMP &lt;font face="Courier New"&gt;screendump&lt;/font&gt;, format ppm&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="32" width="218" height="70" as="geometry"/></mxCell><mxCell id="s2" value='&lt;b style="font-size:14px"&gt;QEMU&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;dumps the VGA picture to a file&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="132" width="218" height="70" as="geometry"/></mxCell><mxCell id="s3" value='&lt;b style="font-size:14px"&gt;frame.ppm&lt;/b&gt;' style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="232" width="218" height="60" as="geometry"/></mxCell><mxCell id="s4" value='&lt;b style="font-size:14px"&gt;&lt;font face="Courier New"&gt;read_bytes&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;&lt;font face="Courier New"&gt;hold&lt;/font&gt; copies to ffmpeg stdin&lt;/span&gt;' style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="322" width="218" height="70" as="geometry"/></mxCell><mxCell id="s5" value='&lt;b style="font-size:14px"&gt;ffmpeg&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px"&gt;image2pipe, libx264 or ffv1&lt;/span&gt;' style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="422" width="218" height="58" as="geometry"/></mxCell><mxCell id="s6" value='&lt;b style="font-size:14px"&gt;video file&lt;/b&gt;' style="shape=note;size=12;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="cap"><mxGeometry x="16" y="506" width="218" height="40" as="geometry"/></mxCell><mxCell id="c9" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#92400E;strokeWidth=2;dashed=1;dashPattern=6 4;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;" edge="1" parent="cap" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="html=1;fontFamily=Helvetica;fontSize=1