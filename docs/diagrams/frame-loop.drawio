ontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="265" y="986" width="1" height="1" as="geometry" /></mxCell><mxCell id="lg_flow_b" value="" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="305" y="986" width="1" height="1" as="geometry" /></mxCell><mxCell id="c23" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;rounded=0;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="lg_flow_a" target="lg_flow_b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="lg_flow_t" value="Call or step" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="311" y="976" width="82" height="22" as="geometry" /></mxCell><mxCell id="att" value="&lt;b&gt;Start: service.attach()&lt;/b&gt;" style="fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;rounded=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" parent="1" vertex="1"><mxGeometry x="20" y="80" width="960" height="100" as="geometry" /></mxCell><mxCell id="att_check" value="&lt;b&gt;check&lt;/b&gt;&lt;br&gt;status channel: one line, no lock" style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" parent="att" vertex="1"><mxGeometry x="16" y="34" width="214" height="56" as="geometry" /></mxCell><mxCell id="att_lock" value="&lt;b&gt;lock&lt;/b&gt;&lt;b