x=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="l3" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="370"/><mxPoint x="720" y="168"/></Array></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="455"/><mxPoint x="716" y="508"/><mxPoint x="10" y="508"/><mxPoint x="10" y="370"/></Array></mxGeometry></mxCell><mxCell id="c17" value="next frame" style="html=1;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;strokeColor=#475569;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=12;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;endSize=7;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="a"><mxGeometry x="-0.3" y="0" relative="1" as="geometry"><Array as="points"><mxPoint x="716" y="455"/><mxPoint x="716" y="508"/><mxPoint x="10" y="508"/><mxPoint x="10" y="168"/></Array></mxGeometry></mxCell><mxCell id="c18" value='Measured: &lt;font face="Courier New"&gt;SYNC&lt;/font&gt; plus one capture takes about 6.5 ms. &lt;font face="Courier New"&gt;hold=n&lt;/font&gt; writes one capture n times, which is what &lt;font face="Courier New"&gt;Scene.pause&lt;/font&gt; does. &lt;font face="Courier New"&gt;play(live=True)&lt;/font&gt; also paces by the host clock, but keeps the sync.' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="526" width="680" height="70