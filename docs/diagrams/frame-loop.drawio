ne.pause&lt;/font&gt; does. &lt;font face=&quot;Courier New&quot;&gt;play(live=True)&lt;/font&gt; also paces by the host clock, but keeps the sync." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="24" y="656" width="680" height="70" as="geometry" /></mxCell><mxCell id="lg_host" value="" style="rounded=1;arcSize=12;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="24" y="952" width="40" height="18" as="geometry" /></mxCell><mxCell id="lg_host_t" value="Host code (Python)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="70" y="950" width="119" height="22" as="geometry" /></mxCell><mxCell id="lg_guest" value="" style="rounded=0;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="197" y="952" width="40" height="18" as="geometry" /></mxCell><mxCell id="lg_guest_t" value="Guest code (Windows 98)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="243" y="950" width="150" height="22" as="geometry" /></mxCell><mxCell id="lg_ext" value="" style="shape=process;fixedSize=1;size=8;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="401" y="952" width="40" height="18" as="geometry" /></mxCell><m