guest repaints) → screendump" tooltip="core/art98/recorder.py:130"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="680" width="280" height="70" as="geometry"/></mxCell></UserObject><UserObject id="c808" label="&lt;b&gt;Animation&lt;/b&gt;: run_time, rate_func, claims, live&lt;br&gt;begin / update / interpolate / finish" tooltip="core/art98/base/animation.py:13"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="0" width="280" height="70" as="geometry"/></mxCell></UserObject><UserObject id="c809" label="&lt;b&gt;Instant&lt;/b&gt;: act() on its one frame&lt;br&gt;(Close, Teleport, Backdrop, Minimize, Maximize…)" tooltip="core/art98/base/animation.py:70"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="280" height="70" as="geometry"/></mxCell></UserObject><UserObject id="c810" label="&lt;b&gt;AnimationGroup&lt;/b&gt; / Succession / LaggedStart&lt;br&gt;child spans from lag_ratio; a child&lt;br&gt;begins when its turn comes" tooltip="core/art98/base/animation.py:89"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="200" width="280" height="90" as="geometry"/></mxCell></UserObject><UserObject id="c811" label="&lt;b&gt;Animate&lt;/b&gt; (prop.animate.move_to(…))&lt;br&gt;replays calls on a ghost at begin,&lt;br&gt;drives only the fields that change" tooltip="core/art98/base/animation.py:210"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="320" width="280" height="90" as="geometry"/></mxCell></UserObject><UserObject id="c812" label="&lt;b&gt;MoveAlongPath&lt;/b&gt;: centre along points&lt;br