label="&lt;b&gt;Animation.begin(scene)&lt;/b&gt; for each&lt;br&gt;(run_time / rate_func overrides first)" tooltip="core/art98/base/animation.py:46"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="230" width="280" height="70" as="geometry"/></mxCell></UserObject><UserObject id="c798" label="&lt;b&gt;scene.add(target)&lt;/b&gt; if not on stage&lt;br&gt;→ Prop.attach: Win spawns, finds,&lt;br&gt;refresh, apply, ready" tooltip="core/art98/anim/scene.py:152"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="280" height="90" as="geometry"/></mxCell></UserObject><UserObject id="c799" label="&lt;b&gt;frames = round(max run_time × fps)&lt;/b&gt;&lt;br&gt;live=True paces by host clock" tooltip="core/art98/anim/timeline.py:9"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="470" width="280" height="70" as="geometry"/></mxCell></UserObject><UserObject id="c800" label="&lt;b&gt;wait / pause / live&lt;/b&gt;&lt;br&gt;pause: one capture × hold&lt;br&gt;wait, live: host-clock frames, no sync" tooltip="core/art98/anim/timeline.py:41"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="600" width="280" height="90" as="geometry"/></mxCell></UserObject><UserObject id="c801" label="&lt;b&gt;each running animation:&lt;/b&gt;&lt;br&gt;update(progress)&lt;br&gt;progress = elapsed / its run_time" tooltip="core/art98/base/animation.py:51"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="0" width="280" height="90" as="geometry"/></mxCell></UserObject><UserObject id="c802" label="&lt;b&gt;rate_func(progress) → in