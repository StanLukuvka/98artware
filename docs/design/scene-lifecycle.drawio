<mxfile><diagram id="scene-lifecycle" name="scene-lifecycle"><mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1340" pageHeight="900" math="0" shadow="0" background="#FFFFFF" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;Life of an animation .py&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="32" as="geometry"/></mxCell><mxCell id="c12" value="Proposed design, not built yet. A scene is one static JSON state with actions chained on top." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c13" value="Creating" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="190" as="geometry"/></mxCell><mxCell id="c14" value="Initializing" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="980" height="190" as="geometry"/></mxCell><mxCell id="c15" value="Acting" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="360" wi