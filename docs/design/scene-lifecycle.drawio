an style=&quot;font-size:13px&quot;&gt;joins the clips into one file&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="830" y="430" width="170" height="100" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Holding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;desktop left as it ended, Python prompt open&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1040" y="430" width="170" height="100" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;VM stays up, with the log and last frame&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#B91C1C;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="180" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Editing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;change the .py or the JSON&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="530" y="680" width="180" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Restarting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;drops the unfinished clip, keeps finished ones&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A