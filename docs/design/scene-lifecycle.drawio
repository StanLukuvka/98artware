 external tool" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="590" y="1040" width="182" height="20" as="geometry" /></mxCell><mxCell id="c65" value="" style="rounded=1;fillColor=#FEE2E2;strokeColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="786" y="1040" width="40" height="20" as="geometry" /></mxCell><mxCell id="c66" value="Failed" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="834" y="1040" width="52" height="20" as="geometry" /></mxCell><mxCell id="t1" value="&lt;b&gt;Life of an animation .py&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=22;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="32" as="geometry" /></mxCell><mxCell id="t2" value="How a scene renders today: boot, a pointer nudge at attach, a blank start or set_state, construct with next_section cuts, then join." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1100" height="24" as="geometry" /></mxCell><mxCell id="g1" value="Creating" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="190" as="geometry" /></mxCell><mxCell id="g2" value="Booting" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="480" height="190" as="geometry" /></mxCell><mxCell id="g3" value="Blank start" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="220" height="190" as="geometry" /></mxCell><mxCell id="g4" value="set_state" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="980" height="190" as="geometry" /></mxCell><mxCell id="g5" value="Recording" style="rounded=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1240" height="190" as="geometry" /></mxCell><mxCell id="s0" value="" style="ellipse;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="141" y="152" width="18" height="18" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;Writing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;scene.py, and a state .json if it starts from one&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#F1F5F9;strokeColor=#475569;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="180" height="100" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;Booting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;restores the ready snapshot, waits for the agent. Local QEMU or the container&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="190" height="100" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Attaching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Pointer.attach: one SetCursorPos nudge&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="190" height="100" as="geometry" /></mxCell><mxCell id="n1" value="The nudge settles the bright, pointerless first frames of a fresh boot." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="810" y="200" width="440" height="60" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Blank desktop&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;black screen, no icons or taskbar; pointer hidden unless pointer_visible&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="180" height="100" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;Loading&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;reads the state file, validates all of it first&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="180" height="100" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Reverting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;loadvm ready, back to the baseline&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="560" y="430" width="180" height="100" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;Applying&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;windows, files and pointer, off camera&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="790" y="430" width="180" height="100" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Checking&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;reads the desktop back; a mismatch fails&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="1020" y="430" width="180" height="100" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b&gt;Constructing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;setup, then construct(): play, pause, wait, live write frames&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#D1FAE5;strokeColor=#059669;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="660" width="190" height="90" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b&gt;Cutting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;next_section(name) closes the clip between two frames&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#DBEAFE;strokeColor=#2563EB;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="620" y="660" width="190" height="90" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b&gt;Joining&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;closes the last clip, joins the clips by stream copy&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEF3C7;strokeColor=#D97706;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="900" y="660" width="190" height="90" as="geometry" /></mxCell><mxCell id="n2" value="set_state inside construct goes back through Reverting. Call next_section first if the screen size changes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="470" y="600" width="780" height="22" as="geometry" /></mxCell><mxCell id="e0" value="" style="ellipse;shape=doubleEllipse;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1140" y="695" width="20" height="20" as="geometry" /></mxCell><mxCell id="n3" value="out.mp4 or .gif" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1100" y="720" width="170" height="24" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;Failed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;bad file, state mismatch, a failed action, a guest crash or ffmpeg: the clip being written is dropped, the VM closes&lt;/span&gt;" style="rounded=1;arcSize=14;fillColor=#FEE2E2;strokeColor=#B91C1C;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=15;fontColor=#0F172A;a